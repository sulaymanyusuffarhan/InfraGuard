# Documentation only; never embed production secrets in the Android application.
INFRAGUARD_API_BASE_URL=https://api.example.invalid/v1/
OIDC_ISSUER=https://identity.example.invalid/
OIDC_CLIENT_ID=replace-with-public-mobile-client-id
# Pilot server only: generate a unique high-entropy value in your secrets manager.
INFRAGUARD_TARGETS_FILE=backend/targets.json
INFRAGUARD_MONITOR_TOKEN=replace-with-random-secret-at-least-32-characters
INFRAGUARD_INTERVAL_SECONDS=30
